config_version=5

[application]

config/name="_balloonroom"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=6
jolt_physics_3d/simulation/position_steps=1
jolt_physics_3d/simulation/sleep_velocity_threshold=0.12
jolt_physics_3d/simulation/sleep_time_threshold=0.4
jolt_physics_3d/limits/temporary_memory_buffer_size=128
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=65536
3d/sleep_threshold_linear=0.12
3d/sleep_threshold_angular=0.15
3d/solver/solver_iterations=4

[rendering]

rendering_device/driver.windows="d3d12"
